      objectReference: {fileID: 0}
    - target: {fileID: 8030394496222595884, guid: a5c73e075de2ad94298f526ee0d42fd7, type: 3}
      propertyPath: debugJson
      value: '{   "object_name": "baseball",   "lua_code": "speed = 0\nbounce_force
        = 0\ntransformProxy = nil\ngameObjectProxy = nil\nrigidbodyProxy = nil\naudioSourceProxy
        = nil\ntextProxy = nil\nbuttonProxy = nil\nparticleSystemProxy = nil\nanimatorProxy
        = nil\n\nfunction V3(x,y,z)\n  if type(Vector3) == \"function\" then return
        Vector3(x,y,z) end\n  return nil\nend\n\nfunction safe_get_name(other)\n 
        if other == nil then return nil end\n  if other.GetName ~= nil then return
        other:GetName() end\n  if other.GetGameObject ~= nil then\n      local go
        = other:GetGameObject()\n      if go ~= nil and go.GetName ~= nil then return
        go:GetName() end\n  end\n  return nil\nend\n\nfunction start()\n  if type(GetRigidbodyProxy)
        == \"function\" then rigidbodyProxy = GetRigidbodyProxy() else print(\"Warning:
        GetRigidbodyProxy not available\") end\n  if type(GetTransformProxy) == \"function\"
        then transformProxy = GetTransformProxy() else print(\"Warning: GetTransformProxy
        not available\") end\nend\n\nfunction update(deltaTime)\n  if rigidbodyProxy
        ~= nil and rigidbodyProxy.SetVelocity ~= nil then\n    rigidbodyProxy:SetVelocity(V3(0,
        speed, 0))\n  end\nend\n\nfunction onCollisionEnter(other)\n  local name
        = safe_get_name(other)\n  if name ~= nil and name == \"baseball bat\" then\n   
        if rigidbodyProxy ~= nil and rigidbodyProxy.AddForce ~= nil then\n      rigidbodyProxy:AddForce(V3(0,
        bounce_force, 0))\n    end\n    if type(activateEffect) == \"function\" then
        activateEffect(\"HitEffect\") end\n  end\nend\n\nfunction trigger()\n  if
        rigidbodyProxy ~= nil and rigidbodyProxy.AddForce ~= nil then\n    rigidbodyProxy:AddForce(V3(0,
        1, 0))\n  end\n  if type(activateEffect) == \"function\" then activateEffect(\"HitEffect\")
        end\nend",   "particle_json": [     {       "effectName": "HitEffect",      
        "duration": "0.5",       "startColor": "1,1,1,1",       "startSize": "0.5",      
        "startSpeed": "5",       "maxParticles": "100",       "shape": "Sphere",      
        "emissionRate": "10",       "lifetime": "1"     }   ],   "param_ui_particle":
        [     {       "effectName": "HitEffect",       "key": "duration",       "type":
        "Slider",       "min": 0,       "max": 1,       "default": 0.5     },    
        {       "effectName": "HitEffect",       "key": "startSpeed",       "type":
        "Slider",       "min": 0,       "max": 10,       "default": 5     },    
        {       "effectName": "HitEffect",       "key": "startSize",       "type":
        "Slider",       "min": 0,       "max": 1,       "default": 0.5     },    
        {       "effectName": "HitEffect",       "key": "lifetime",       "type":
        "Slider",       "min": 0,       "max": 2,       "default": 1     }   ],  
        "param_ui_lua": [     {       "key": "speed",       "type": "Slider",      
        "min": 0,       "max": 10,       "default": 0     },     {       "key": "bounce_force",      
        "type": "Slider",       "min": 0,       "max": 10,       "default": 0    
        }   ],   "comment": "When the baseball collides with the baseball bat, it
        bounces off and activates the HitEffect particle. The speed (slider) of the
        baseball and the bounce_force (slider) it experiences on collision can be
        adjusted.",   "created_at": "2025-08-14T21:56:15.018843" }'
      objectReference: {fileID: 0}
