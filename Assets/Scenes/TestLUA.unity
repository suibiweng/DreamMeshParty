    - target: {fileID: 8030394496222595884, guid: a5c73e075de2ad94298f526ee0d42fd7, type: 3}
      propertyPath: debugJson
      value: '{   "object_name": "baseball bat",   "lua_code": "speed = 0\nbounce_force
        = 0\ntransformProxy = nil\ngameObjectProxy = nil\nrigidbodyProxy = nil\naudioSourceProxy
        = nil\ntextProxy = nil\nbuttonProxy = nil\nparticleSystemProxy = nil\nanimatorProxy
        = nil\n\nfunction start()\n  if type(GetRigidbodyProxy) == ''function'' then
        rigidbodyProxy = GetRigidbodyProxy() else print(''Warning: GetRigidbodyProxy
        not available'') end\n  if rigidbodyProxy ~= nil and rigidbodyProxy.SetUseGravity
        ~= nil then rigidbodyProxy:SetUseGravity(true) end\nend\n\nfunction update(deltaTime)\nend\n\nfunction
        onCollisionEnter(other)\n  if type(activateEffect) == ''function'' then activateEffect(''BatHitEffect'')
        end\nend\n\nfunction trigger()\n  if rigidbodyProxy ~= nil and rigidbodyProxy.AddForce
        ~= nil then\n    rigidbodyProxy:AddForce(0, 1 * speed, 0)\n  end\n  if type(activateEffect)
        == ''function'' then activateEffect(''BatHitEffect'') end\nend",   "particle_json":
        [     {       "effectName": "BatHitEffect",       "duration": "1.0",      
        "startColor": "1,1,1,1",       "startSize": "1.0",       "startSpeed": "1.0",      
        "maxParticles": "100",       "shape": "Sphere",       "emissionRate": "100",      
        "lifetime": "1.0"     }   ],   "param_ui_particle": [     {       "effectName":
        "BatHitEffect",       "key": "startSpeed",       "type": "Slider",      
        "min": 0,       "max": 5,       "default": 1     },     {       "effectName":
        "BatHitEffect",       "key": "startSize",       "type": "Slider",       "min":
        0,       "max": 5,       "default": 1     },     {       "effectName": "BatHitEffect",      
        "key": "lifetime",       "type": "Slider",       "min": 0,       "max": 5,      
        "default": 1     }   ],   "param_ui_lua": [     {       "key": "speed",      
        "type": "Slider",       "min": 0,       "max": 10,       "default": 0    
        }   ],   "comment": "The baseball bat does not interact with the user. When
        it hits the ball, it applies force and activates the hit particle (BatHitEffect).",  
        "created_at": "2025-08-14T22:00:02.321088" }'
      objectReference: {fileID: 0}
    - target: {fileID: 8030394496222595884, guid: a5c73e075de2ad94298f526ee0d42fd7, type: 3}
